# Copy to .env. Keys stay on this computer and are never sent to the browser.
# Edit this file's local copy and retry. The server reads .env on each AI request.
TRACE_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Blank uses Claude Haiku 5.5 or Gemini 2.5 Flash. Set an ID to choose another model.
TRACE_MODEL_ID=

# For Gemini, set TRACE_AI_PROVIDER=gemini and fill this key.
GEMINI_API_KEY=

# For LiteLLM, set TRACE_AI_PROVIDER=litellm and the gateway model alias above.
LITELLM_URL=http://localhost:4000/v1
LITELLM_MASTER_KEY=
